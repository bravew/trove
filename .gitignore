# Dependencies
node_modules/

# Build output
dist/
output/

# Internal staging directory (rebuild with `bun run build`)
plugins/*/output/

# Distribution artifacts ARE committed: Claude Code's `/plugin marketplace
# add bravew/trove` clones the repo and reads these files
# directly with no build step (matches the pattern used by
# anthropics/claude-code/plugins and anthropics/claude-plugins-official).
# The release workflow regenerates them. CI freshness checks for
# build:skills, build:routing, and build:deps catch stale copies; adding
# --dry-run support to build:plugins and build:marketplace is a TODO.
#
# Tracked distribution paths (do NOT add to .gitignore):
#   - .claude-plugin/marketplace.json     ← Claude marketplace catalog
#   - .cursor-plugin/marketplace.json     ← Cursor marketplace catalog
#   - .agents/plugins/marketplace.json    ← AGENTS.md scoped catalog
#   - catalog.json                        ← CLI catalog
#   - plugins/*/skills/<name>/SKILL.md    ← per-plugin skill bundles
#   - plugins/*/commands/<name>.md        ← copied from top-level commands/
#   - plugins/*/.claude-plugin/plugin.json
#   - plugins/*/.cursor-plugin/plugin.json
#   - plugins/*/.codex-plugin/plugin.json

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/settings.json

# Environment
.env
.env.local

# Bun
bun.lockb

# pnpm (this is a bun repo — pnpm-lock.yaml is generated by accidental `pnpm install`)
pnpm-lock.yaml

# Local Claude Code state — keep shared config (.claude/settings.json,
# .claude/commands/, .claude/skills/, .claude/agents/, .claude/hooks/)
# committable; ignore only per-user state.
.claude/settings.local.json
.claude/todos/

# Eval results (regenerated on each eval run)
evals/results.json

# Debug
*.log

# deps.json IS committed (paired with the `build:deps -- --dry-run` CI
# check) so the dependency graph is visible in PR diffs and the freshness
# check has signal. Same pattern as docs/routing.md.

_sample/
