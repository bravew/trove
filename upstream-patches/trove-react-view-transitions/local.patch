-  animation-duration: 220ms;
-  animation-timing-function: cubic-bezier(0.5, 0, 0.2, 1);
-}
-::view-transition-old(.tab-underline),
-::view-transition-new(.tab-underline) {
-  animation: none;
-  height: 100%;
-}
