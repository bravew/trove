#!/usr/bin/env bash
# ─── Trove — Universal Installer ───────────
#
# Detects installed AI coding assistants and sets up marketplace integration.
#
# Usage:
#   ./setup                    # Auto-detect hosts
#   ./setup --host claude      # Claude Code only
#   ./setup --host cursor      # Cursor only
#   ./setup --host codex       # Codex only
#   ./setup --host copilot     # Copilot CLI AGENTS fallback
#   ./setup --host opencode    # OpenCode only
#   ./setup --host gemini      # Gemini CLI only
#   ./setup --host cursor --host codex
#   ./setup --host all         # All detected hosts
#   ./setup --role dev         # Developer plugins only
#   ./setup --role design      # Designer plugins only
#   ./setup --role all         # All roles (default)
#   ./setup --uninstall        # Remove every link this installer created
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION=$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown")

# ── Colors ───────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${BLUE}ℹ${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
err()   { echo -e "${RED}✗${NC} $*" >&2; }
header(){ echo -e "\n${BOLD}── $* ──${NC}"; }

# ── Arg parsing ──────────────────────────────────────────────
HOST_ARGS=()
ROLE_ARG="all"
UNINSTALL=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) HOST_ARGS+=("$2"); shift 2 ;;
    --role) ROLE_ARG="$2"; shift 2 ;;
    --uninstall) UNINSTALL=1; shift ;;
    --help|-h)
      echo "Usage: ./setup [--host claude|cursor|codex|opencode|gemini|copilot|agents|all]... [--role dev|design|pm|devops|all]"
      echo "       ./setup --uninstall"
      exit 0
      ;;
    *) err "Unknown argument: $1"; exit 1 ;;
  esac
done

# ── Link bookkeeping ─────────────────────────────────────────
#
# Every symlink this installer creates is recorded, so `--uninstall` can undo
# exactly what was installed and nothing else. A target that is not one of our
# links is never touched: a user skill that happens to share a name with a
# Trove skill wins, and we say so.
TROVE_STATE_DIR="${TROVE_HOME:-$HOME/.trove}"
LINK_MANIFEST="$TROVE_STATE_DIR/installed-links.tsv"
LINK_HOST=""

owned_by_trove() {
  # $1: an existing symlink path. True when it resolves inside this checkout.
  local resolved
  resolved=$(readlink "$1" 2>/dev/null || echo "")
  [[ -n "$resolved" && "$resolved" == "$SCRIPT_DIR"/* ]]
}

# forget_host_links <host> — drop this host'"'"'s rows from the manifest.
forget_host_links() {
  [[ -f "$LINK_MANIFEST" ]] || return 0
  local tmp
  tmp=$(mktemp)
  grep -v "^$1	" "$LINK_MANIFEST" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$LINK_MANIFEST"
}

# link_skill <source-skill-dir> <target-path>
link_skill() {
  local src="$1" target="$2"
  [[ -f "$src/SKILL.md" ]] || return 0

  if [[ -L "$target" ]]; then
    if owned_by_trove "$target"; then
      rm "$target"
    else
      warn "Skipping $(basename "$target"): $target is a symlink we did not create"
      return 0
    fi
  elif [[ -e "$target" ]]; then
    warn "Skipping $(basename "$target"): $target already exists and is not a Trove link"
    return 0
  fi

  ln -sfn "$src" "$target"
  mkdir -p "$TROVE_STATE_DIR"
  printf '%s\t%s\n' "$LINK_HOST" "$target" >> "$LINK_MANIFEST"
}

# link_skill_tree <host> <source-root> <target-root>
#
# Hosts discover a skill at `<root>/<skill-name>/SKILL.md`. A grouping folder
# such as `<root>/trove/<skill>` is read as a skill directory with no
# SKILL.md, so the links are flat. Cursor is the exception — it documents
# recursive grouping — and passes its own grouped target root.
link_skill_tree() {
  LINK_HOST="$1"
  local source_root="$2" target_root="$3"
  forget_host_links "$LINK_HOST"

  if [[ ! -d "$source_root" ]]; then
    warn "No generated skills at $source_root. Did the build run?"
    return 0
  fi

  mkdir -p "$target_root"
  local count=0
  for skill_dir in "$source_root"/*/; do
    [[ -d "$skill_dir" ]] || continue
    link_skill "${skill_dir%/}" "$target_root/$(basename "$skill_dir")"
    count=$((count + 1))
  done
  ok "$count skill(s) linked into $target_root"
}

uninstall_links() {
  header "Uninstall"
  if [[ ! -f "$LINK_MANIFEST" ]]; then
    info "No installed-link manifest at $LINK_MANIFEST — nothing to remove."
    return 0
  fi
  local removed=0 kept=0
  while IFS=$'\t' read -r host target; do
    [[ -n "${target:-}" ]] || continue
    if [[ -L "$target" ]] && owned_by_trove "$target"; then
      rm "$target"
      removed=$((removed + 1))
    else
      kept=$((kept + 1))
    fi
  done < "$LINK_MANIFEST"
  rm -f "$LINK_MANIFEST"
  ok "Removed $removed link(s); left $kept entry/entries that were no longer ours"
}

if [[ "$UNINSTALL" -eq 1 ]]; then
  uninstall_links
  exit 0
fi

# ── Host detection ───────────────────────────────────────────
detect_hosts() {
  local hosts=()

  if command -v claude &>/dev/null; then
    hosts+=("claude")
  fi

  if command -v cursor &>/dev/null || [[ -d "$HOME/.cursor" ]]; then
    hosts+=("cursor")
  fi

  if command -v codex &>/dev/null; then
    hosts+=("codex")
  fi

  if command -v copilot &>/dev/null; then
    hosts+=("copilot")
  fi

  if command -v opencode &>/dev/null || [[ -d "$HOME/.config/opencode" ]]; then
    hosts+=("opencode")
  fi

  if command -v gemini &>/dev/null || [[ -d "$HOME/.gemini" ]]; then
    hosts+=("gemini")
  fi

  # Always include "agents" (generic AGENTS.md)
  hosts+=("agents")

  echo "${hosts[@]}"
}

# Read preferred hosts from `~/.trove/config.yaml` (or $TROVE_HOME).
# Returns empty when no config is present, so the caller falls back to
# auto-detection. We delegate to `bin/trove` so YAML parsing lives in
# one place (TypeScript) instead of hand-rolled bash.
hosts_from_config() {
  if ! command -v bun &>/dev/null; then
    echo ""
    return
  fi
  if [[ ! -x "$SCRIPT_DIR/bin/trove" ]]; then
    echo ""
    return
  fi
  # Only treat config as authoritative if a config file actually exists —
  # otherwise `config get hosts` returns the default `claude, cursor`,
  # which would mask real auto-detection.
  local cfg_dir="${TROVE_HOME:-$HOME/.trove}"
  if [[ ! -f "$cfg_dir/config.yaml" ]]; then
    echo ""
    return
  fi
  "$SCRIPT_DIR/bin/trove" config get hosts 2>/dev/null | tr ',' ' ' | xargs || echo ""
}

if [[ "${#HOST_ARGS[@]}" -gt 0 ]]; then
  if [[ " ${HOST_ARGS[*]} " == *" all "* ]]; then
    HOSTS=$(detect_hosts)
  else
    HOSTS="${HOST_ARGS[*]}"
  fi
else
  CONFIG_HOSTS=$(hosts_from_config)
  if [[ -n "$CONFIG_HOSTS" ]]; then
    info "Using hosts from ~/.trove/config.yaml"
    HOSTS="$CONFIG_HOSTS"
  else
    HOSTS=$(detect_hosts)
  fi
fi

# ── Prerequisites ────────────────────────────────────────────
header "Trove v${VERSION}"
info "Hosts: ${HOSTS}"
info "Role: ${ROLE_ARG}"

# Check for bun
if ! command -v bun &>/dev/null; then
  err "bun is required. Install: https://bun.sh"
  exit 1
fi

# ── Install dependencies ────────────────────────────────────
header "Installing dependencies"
cd "$SCRIPT_DIR"
bun install --frozen-lockfile 2>/dev/null || bun install
ok "Dependencies installed"

# ── Build ────────────────────────────────────────────────────
header "Building marketplace"
bun run build
ok "Build complete"

# ── Claude Code setup ────────────────────────────────────────
setup_claude() {
  header "Claude Code"

  local marketplace_json="$SCRIPT_DIR/.claude-plugin/marketplace.json"
  if [[ ! -f "$marketplace_json" ]]; then
    err "marketplace.json not found. Build may have failed."
    return 1
  fi

  # Check if Claude CLI supports marketplace commands
  if claude plugin marketplace list &>/dev/null 2>&1; then
    info "Adding marketplace to Claude Code..."
    claude plugin marketplace add "$SCRIPT_DIR" 2>/dev/null && \
      ok "Marketplace registered" || \
      warn "Could not register marketplace (may already be registered)"
  else
    # Fallback: link skills directly.
    #
    # Personal skills are discovered at `~/.claude/skills/<skill-name>/SKILL.md`
    # only. The previous `~/.claude/skills/trove/<skill>` layout put a grouping
    # directory where Claude expects a skill directory, so nothing under it was
    # found. Source: code.claude.com/docs/en/skills ("Where skills live").
    info "Setting up skills via symlinks..."
    LINK_HOST="claude"
    forget_host_links "claude"
    mkdir -p "$HOME/.claude/skills"

    local linked=0
    for plugin_dir in "$SCRIPT_DIR"/plugins/*/; do
      local skills_path="$plugin_dir/skills"
      [[ -d "$skills_path" ]] || continue
      for skill_dir in "$skills_path"/*/; do
        [[ -d "$skill_dir" ]] || continue
        link_skill "${skill_dir%/}" "$HOME/.claude/skills/$(basename "$skill_dir")"
        linked=$((linked + 1))
      done
    done

    ok "$linked skill(s) linked into ~/.claude/skills/"
  fi
}

# ── Cursor setup ─────────────────────────────────────────────
setup_cursor() {
  header "Cursor"

  local marketplace_json="$SCRIPT_DIR/.cursor-plugin/marketplace.json"
  if [[ ! -f "$marketplace_json" ]]; then
    warn "Cursor marketplace.json not found. Skipping."
    return 0
  fi

  # Cursor documents recursive grouping under its skills root, so the `trove/`
  # folder here is supported and keeps Trove skills separable from a user's own.
  LINK_HOST="cursor"
  forget_host_links "cursor"
  local skills_dir="$HOME/.cursor/skills/trove"
  mkdir -p "$skills_dir"

  local linked=0
  for plugin_dir in "$SCRIPT_DIR"/plugins/*/; do
    local skills_path="$plugin_dir/skills"
    [[ -d "$skills_path" ]] || continue
    for skill_dir in "$skills_path"/*/; do
      [[ -d "$skill_dir" ]] || continue
      link_skill "${skill_dir%/}" "$skills_dir/$(basename "$skill_dir")"
      linked=$((linked + 1))
    done
  done

  ok "$linked skill(s) linked into ~/.cursor/skills/trove/"
}

# ── Codex setup ──────────────────────────────────────────────
setup_codex() {
  header "Codex"

  # Codex's user scope is `$HOME/.agents/skills/<skill>/SKILL.md`; the previous
  # `.../trove/<skill>` nesting shifted every skill one level too deep.
  # Source: developers.openai.com/codex/skills (USER scope row).
  link_skill_tree "codex" "$SCRIPT_DIR/output/codex/.agents/skills" "$HOME/.agents/skills"
}

# ── OpenCode setup ───────────────────────────────────────────
setup_opencode() {
  header "OpenCode"

  # `~/.config/opencode/skills` is OpenCode's documented global root. Its
  # project roots (`.opencode/skills`, `.agents/skills`, `.claude/skills`) are
  # per-repository and are not an installer's business.
  # Source: opencode.ai/docs/skills.
  link_skill_tree "opencode" "$SCRIPT_DIR/output/opencode/.agents/skills" \
    "$HOME/.config/opencode/skills"

  local plugin_root="$SCRIPT_DIR/output/opencode/plugins"
  if [[ -d "$plugin_root" ]]; then
    info "OpenCode plugins generated in $plugin_root — copy one into your project's .opencode/plugin/"
  fi
}

# ── Gemini CLI setup ─────────────────────────────────────────
setup_gemini() {
  header "Gemini CLI"

  # Gemini loads extensions from <home>/.gemini/extensions, and each generated
  # extension carries its plugin's bundled skills plus GEMINI.md context.
  # `gemini extensions link` is the documented way to point at a working
  # directory, so use it when the CLI is present and fall back to symlinks.
  # Source: geminicli.com/docs/extensions/reference.
  local ext_source="$SCRIPT_DIR/output/gemini/plugins"
  if [[ ! -d "$ext_source" ]]; then
    warn "No generated Gemini extensions at $ext_source. Did the build run?"
    return 0
  fi

  LINK_HOST="gemini"
  forget_host_links "gemini"
  mkdir -p "$HOME/.gemini/extensions"

  local linked=0
  for ext_dir in "$ext_source"/*/; do
    [[ -f "$ext_dir/gemini-extension.json" ]] || continue
    local name
    name=$(basename "$ext_dir")
    if command -v gemini &>/dev/null && gemini extensions link "${ext_dir%/}" &>/dev/null; then
      linked=$((linked + 1))
      continue
    fi
    local target="$HOME/.gemini/extensions/$name"
    if [[ -L "$target" ]]; then
      if owned_by_trove "$target"; then rm "$target"; else
        warn "Skipping $name: $target is a symlink we did not create"
        continue
      fi
    elif [[ -e "$target" ]]; then
      warn "Skipping $name: $target already exists and is not a Trove link"
      continue
    fi
    ln -sfn "${ext_dir%/}" "$target"
    mkdir -p "$TROVE_STATE_DIR"
    printf '%s\t%s\n' "gemini" "$target" >> "$LINK_MANIFEST"
    linked=$((linked + 1))
  done

  ok "$linked Gemini extension(s) installed"
}

# ── Copilot CLI setup ────────────────────────────────────────
setup_copilot() {
  header "Copilot CLI"

  warn "Copilot CLI sessionStart command output is not processed by current GitHub docs; using AGENTS.md fallback."

  if ! command -v copilot &>/dev/null; then
    warn "copilot CLI not found. Skipping."
    return 0
  fi

  setup_agents
}

# ── Generic (AGENTS.md) setup ────────────────────────────────
setup_agents() {
  header "Generic (AGENTS.md)"
  info "Generated AGENTS.md available in output/agents/"
  ok "Copy to project roots as needed"
}

# ── Run host setups ──────────────────────────────────────────
for host in $HOSTS; do
  case "$host" in
    claude)   setup_claude   ;;
    cursor)   setup_cursor   ;;
    codex)    setup_codex    ;;
    opencode) setup_opencode ;;
    gemini)   setup_gemini   ;;
    copilot)  setup_copilot  ;;
    agents)   setup_agents   ;;
    *)        warn "Unknown host: $host" ;;
  esac
done

# ── Summary ──────────────────────────────────────────────────
header "Setup Complete"
echo ""
info "Marketplace version: ${VERSION}"
info "Update: cd $(basename "$SCRIPT_DIR") && git pull && ./setup"
echo ""
ok "Trove is ready!"
