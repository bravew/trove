{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trove-broll-ingest/catalog",
  "title": "B-roll catalog",
  "description": "One entry per graded select. The file lives at the library root the user supplies, never inside the skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["library", "selects"],
  "properties": {
    "library": { "type": "string", "minLength": 1 },
    "selects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "source", "span", "category", "description", "transfer", "stabilized"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "span": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "transfer": { "enum": ["rec709", "slog3", "other"] },
          "lut": { "type": "string" },
          "stabilized": { "type": "boolean" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
